<IfModule mod_rewrite.c>
    RewriteEngine On

    # Let storage URLs reach files in Laravel's public folder
    RewriteRule ^storage/(.*)$ public/storage/$1 [L]

    # Send other requests to Laravel's public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>